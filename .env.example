# Copier ce fichier en `.env` et remplir les valeurs.

# --- LLM principal (extraction des contraintes + narration) ---
LLM_BASE_URL=https://api.medium.text-generation-webui.myia.io/v1
LLM_API_KEY=<demande_ta_cle>
LLM_MODEL=qwen3.6-35b-a3b

# --- LLM fallback (utilise si le principal echoue) ---
LLM_BASE_URL_FALLBACK=https://api.mini.text-generation-webui.myia.io/v1
LLM_API_KEY_FALLBACK=<demande_ta_cle>
LLM_MODEL_FALLBACK=omnicoder-9b

# --- OpenTripMap (verification des activites) ---
# Cle gratuite : https://opentripmap.io/product
OPENTRIPMAP_API_KEY=<inscris_toi_pour_avoir_ta_cle>

# --- Serveur FastAPI ---
API_HOST=127.0.0.1
API_PORT=8000
